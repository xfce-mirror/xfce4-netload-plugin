#: panel-plugin/netload.c:396
#, c-format
msgid ""
"<< %s >> (%s)\n"
"Average of last %d measures\n"
"with an interval of %.2fs:\n"
"Incoming: %s\n"
"Outgoing: %s\n"
"Total: %s"
msgstr "<< %s >> (%s)\n直近の %d 測定分の平均\n測定間隔: %.2f 秒\n受信: %s/s\n送信: %s/s\n合計: %s/s"

#: panel-plugin/netload.c:399
