msgid ""
"<< %s >> (%s)\n"
"Average of last %d measures\n"
"with an interval of %.2fs:\n"
"Incoming: %s\n"
"Outgoing: %s\n"
"Total: %s"
msgstr "«%s» (%s)\nСреднее последних %d измерений\nс интервалом %.2f с:\nВходящий: %s\nИсходящий: %s\nВсего: %s"

