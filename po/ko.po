#, c-format
msgid ""
"<< %s >> (%s)\n"
"Average of last %d measures\n"
"with an interval of %.2fs:\n"
"Incoming: %s\n"
"Outgoing: %s\n"
"Total: %s"
msgstr "<< %s >> (%s)\n최근 %d 회 측정 평균주기시간: %.2fs\n수신: %s/s\n송신: %s/s\n총계: %s/s"

#: panel-plugin/netload.c:399
msgid "no IP address"
msgstr "IP 주소가 없습니다."

